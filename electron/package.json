{
  "name": "cloudshield",
  "version": "1.0.0",
  "description": "AWS Cloud Control Panel — Security Scanner & Remediation",
  "main": "main.js",
  "author": "NSudeep",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.nsudeep.cloudshield",
    "productName": "CloudShield",
    "copyright": "Copyright © 2025 NSudeep",
    "win": {
      "target": [{"target": "dir"}],
      "icon": "../installer/images/icon.ico"
    },
    "files": [
      "main.js",
      "tray.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/ui/dist",
        "to": "ui"
      }
    ],
    "asar": true
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
