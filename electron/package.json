{
  "name": "cloudshield",
  "version": "1.0.1",
  "description": "AWS Cloud Control Panel — Security Scanner & Remediation",
  "main": "main.js",
  "author": "NSudeep",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-linux": "electron-builder --linux deb --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.nsudeep.cloudshield",
    "productName": "CloudShield",
    "copyright": "Copyright © 2025 NSudeep",
    "win": {
      "target": [{"target": "dir"}],
      "icon": "../installer/images/icon.ico"
    },
    "linux": {
      "target": [{"target": "deb", "arch": ["x64"]}],
      "icon": "../installer/images/icon.png",
      "category": "Utility",
      "description": "AWS Cloud Security Scanner & Auto-Remediation Panel",
      "executableName": "cloudshield",
      "extraResources": [
        { "from": "../dist/cloudshield-backend", "to": "cloudshield-backend" },
        { "from": "../installer/images/icon.png", "to": "app/icon.png" }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0", "libnotify4", "libnss3", "libxss1",
        "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1"
      ]
    },
    "files": [
      "main.js",
      "main-linux.js",
      "tray.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/ui/dist",
        "to": "ui"
      },
      {
        "from": "../installer/images/icon.ico",
        "to": "app/icon.ico"
      },
      {
        "from": "../installer/images/tray_icon.ico",
        "to": "app/tray_icon.ico"
      }
    ],
    "asar": true
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
